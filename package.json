{
  "name": "senars3",
  "version": "1.0.0",
  "description": "Verifiable, goal-directed, and self-reflective reasoning system with hybrid symbolic and semantic cognition",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:frontend && tsc",
    "start": "npm run build && node dist/web/unifiedServer.js",
    "demo": "ts-node src/testing/demo.ts",
    "test:community": "ts-node src/testing/communitySimulatorTest.ts",
    "test:community-integration": "ts-node src/testing/communitySimulatorIntegrationTest.ts",
    "test:usability": "ts-node src/testing/usabilityIntegrityTest.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "docs:usability": "cat USABILITY_ENHANCEMENTS.md",
    "docs:enhanced": "cat ENHANCED_USABILITY_FEATURES.md",
    "dev": "ts-node src/web/unifiedServer.ts",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "preview:frontend": "vite preview",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix"
  },
  "keywords": [
    "ai",
    "cognitive",
    "reasoning",
    "goal-directed",
    "symbolic-ai",
    "semantic-cognition",
    "knowledge-representation",
    "cognitive-architecture",
    "artificial-intelligence",
    "nlp",
    "natural-language-processing"
  ],
  "author": "Senars3 Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@langchain/community": "^0.3.53",
    "@xenova/transformers": "^2.17.2",
    "chart.js": "^4.4.3",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "framer-motion": "^12.23.12",
    "langchain": "^0.3.31",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "zod": "^3.23.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.1",
    "jest-util": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^5.4.19"
  }
}
